---
// Adds a Copy button to every code block on the page. Included once in Base.astro,
// so it covers blog posts and the /prompts/ library alike.
// Styles live in the global block in Base.astro (.code-wrap / .copy-btn).
---
<script>
  // Wrap each pre in a positioned container: pre scrolls horizontally, so a button
  // placed inside it would scroll out of view with the code.
  const blocks = document.querySelectorAll('pre:not(.mermaid)');
  if (blocks.length && navigator.clipboard) {
    for (const pre of blocks) {
      const code = pre.querySelector('code');
      if (!code || !pre.parentNode) continue;

      const wrap = document.createElement('div');
      wrap.className = 'code-wrap';
      pre.parentNode.insertBefore(wrap, pre);
      wrap.appendChild(pre);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-btn';
      btn.textContent = 'Copy';
      btn.setAttribute('aria-label', 'Copy code to clipboard');
      btn.setAttribute('data-pagefind-ignore', '');

      let reset;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.innerText);
          btn.textContent = 'Copied';
          btn.classList.add('is-copied');
        } catch {
          // Clipboard write can be refused (permissions, insecure context). Select the
          // code so the fallback instruction actually works.
          const range = document.createRange();
          range.selectNodeContents(code);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
          btn.textContent = 'Press Ctrl+C';
        }
        clearTimeout(reset);
        reset = setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('is-copied');
        }, 1500);
      });

      wrap.appendChild(btn);
    }
  }
</script>
