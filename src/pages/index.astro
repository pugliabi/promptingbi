---
import Base from '../layouts/Base.astro';
import PostListItem from '../components/PostListItem.astro';
import { publishedPosts, PAGE_SIZE } from '../lib/posts';

const allPosts = await publishedPosts();
const posts = allPosts.slice(0, PAGE_SIZE);
const hasOlder = allPosts.length > PAGE_SIZE;
---
<Base>
  <section class="home-intro">
    <p>
      Prompting BI is where business intelligence and prompt engineering meet. It's
      a space for dialogue on navigating the ever-changing world of BI through AI.
      I'm <a href="/about/">Tommy Puglia</a>, Microsoft MVP (2019-2025) and Power BI consultant,
      writing for the Power BI and Fabric professionals figuring out how to use
      generative AI well.
    </p>
  </section>
  <ul class="post-list">
    {posts.map((post) => <PostListItem post={post} />)}
  </ul>
  {hasOlder && (
    <nav class="pagination" aria-label="Pagination">
      <a href="/page/2/">Older posts →</a>
    </nav>
  )}
</Base>
