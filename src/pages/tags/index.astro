---
import Base from '../../layouts/Base.astro';
import { publishedPosts } from '../../lib/posts';
import { tagDisplay } from '../../lib/tags.mjs';

const all = await publishedPosts();
const counts = new Map<string, number>();
for (const post of all) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const tags = [...counts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
);
---
<Base
  title="Tags - Prompting BI"
  description="Browse Prompting BI posts by topic."
>
  <section class="tag-header">
    <h1>Tags</h1>
    <p class="post-date">Browse posts by topic.</p>
  </section>
  <div class="tag-pills tag-index">
    {tags.map(([slug, count]) => (
      <a class="tag-pill" href={`/tags/${slug}/`}>
        {tagDisplay(slug)} <span class="tag-count">({count})</span>
      </a>
    ))}
  </div>
</Base>
